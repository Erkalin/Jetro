# dependencies
node_modules/

# build outputs (regenerable — never commit)
dist/
dist-electron/
dist-scripts/
dist-ssr/
release/
.vite/

# typescript
*.tsbuildinfo

# test / coverage
coverage/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# editors
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
*.suo
*.user

# environment (keep .env.example if you add one)
.env
.env.*
!.env.example

# merge / patch leftovers
*.orig
*.rej

# local-only files
*.local

# electron-builder leftovers (belt & suspenders — release/ already covers these)
*.blockmap

# temp electron-builder config (build-release.js deletes it
# after a successful build; --keep-config leaves it for debugging)
electron-builder.release.json

# vendored binaries (fetched at build time, not committed)
# NOTE: use bin/* (not bin/) so the ! exception for .gitkeep actually works —
# git cannot re-include files inside an excluded directory.
bin/*
!bin/.gitkeep
